{
  "name": "dsh-hub",
  "version": "0.2.0",
  "private": true,
  "description": "DSH Hub — 多人使用的 DeepSeek Harness 多实例管理器（单机 Linux 服务器）",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "spike:s1": "node spikes/s1-reverse-proxy.mjs",
    "spike:s2": "node spikes/s2-trusted-host.mjs",
    "spike:s3": "bash spikes/s3-systemd-run.sh",
    "spike:s4": "node spikes/s4-npx-version.mjs",
    "spike:s5": "node spikes/s5-nickname-dir.mjs",
    "spike:all": "node spikes/run-all.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
